+// Recursively writes a Ramulator2 ConfigNode as YAML-formatted text.
+// Hand-rolled to avoid depending on yaml-cpp's operator<<(ostream&, YAML::Node
+// const&) -- that symbol isn't linked into libmemHierarchy.so (undefined
+// symbol: _ZN4YAMLlsERSoRKNS_4NodeE at load time), so this sidesteps the
+// dependency entirely rather than requiring a build-system change.
+static void writeConfigNodeYaml(std::ostream& os, const Ramulator::ConfigNode& node, int indent) {
+    const std::string pad(indent * 2, ' ');
+
+    if (node.is_map()) {
+        if (node.map().empty()) {
+            os << "{}\n";
+            return;
+        }
+        for (const auto& [key, child] : node.map()) {
+            if (child.is_map() && !child.map().empty()) {
+                os << pad << key << ":\n";
+                writeConfigNodeYaml(os, child, indent + 1);
+            } else if (child.is_sequence() && !child.seq().empty()) {
+                os << pad << key << ":\n";
+                writeConfigNodeYaml(os, child, indent + 1);
+            } else if (child.is_scalar()) {
+                os << pad << key << ": " << child.scalar() << "\n";
+            } else {
+                os << pad << key << ": {}\n";  // empty map/seq/null
+            }
+        }
+    } else if (node.is_sequence()) {
+        for (const auto& child : node.seq()) {
+            if (child.is_scalar()) {
+                os << pad << "- " << child.scalar() << "\n";
+            } else {
+                os << pad << "-\n";
+                writeConfigNodeYaml(os, child, indent + 1);
+            }
+        }
+    } else if (node.is_scalar()) {
+        os << pad << node.scalar() << "\n";
+    }
+    // is_null() -- write nothing
+}
 
